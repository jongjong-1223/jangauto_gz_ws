    <joint name="guide_R_joint" type="revolute">
      <parent>wheel_R5_link</parent>
      <child>guide_R_link</child>

      <pose>0 0 0 0 0 0</pose>

      <axis>
        <xyz>0 -1 0</xyz>

        <limit>
          <lower>-1000000</lower>
          <upper>1000000</upper> 
        </limit>

        <dynamics>
          <damping>0.1</damping> 
          <friction>0.0</friction> 
