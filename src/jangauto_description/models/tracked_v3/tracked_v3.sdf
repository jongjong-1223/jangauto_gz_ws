      <sensor name="navsat_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>1.0</update_rate> <!-- 주파수 현실에 맞게 수정 -->
        <topic>navsat</topic>
        <visualize>false</visualize>
          <pose>0 0 0.25 0 0 0</pose>
      </sensor>

      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>true</always_on>
        <update_rate>25.0</update_rate>
        <topic>magnetometer</topic>
          <pose>0 0 0.25 0 0 0</pose>

      </sensor>

      <!-- 전방 뎁스카메라: nav2 코스트맵/collision_monitor의 장애물 인식(안전정지)용 소스.
           차체 전면(x=0.55, 차체 길이 1.1m의 절반) 상단에 진행방향을 향해 장착.
           gz-sim이 <topic> 하위로 image/depth_image/points/camera_info를 자동 발행한다. -->
      <sensor name="front_depth_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>front_depth_camera</topic>
        <pose>0.55 0 0.25 0 0 0</pose>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>

    </link>


    <link name="wheel_R1_link">
        <!-- 전방 우측 바퀴 1: x=0.44m, y=-0.751m (우측 바깥) -->
        <pose>0.44 -0.751 0.1 1.5708 0 0</pose>

      <visual name="wheel_R1_visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="wheel_R1_collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.2</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>0.7</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.0</slip1>
              <slip2>0.001</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0.002</soft_cfm>
              <soft_erp>0.002</soft_erp>
              <kp>1000</kp>
              <kd>500</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.0365</ixx>
          <iyy>0.0365</iyy>
          <izz>0.025</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <joint name="wheel_R1_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_R1_link</child>

      <pose>0 0 0 0 0 0</pose>

      <axis>
        <xyz>0 0 -1</xyz>

        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>10000.0</effort>
          <velocity>10000.0</velocity>
        </limit>

        <dynamics>
          <damping>0.1</damping> 
          <friction>0.01</friction> 
        </dynamics>
      </axis>

      <physics>
        <provide_feedback>true</provide_feedback>
      </physics>

    </joint>


