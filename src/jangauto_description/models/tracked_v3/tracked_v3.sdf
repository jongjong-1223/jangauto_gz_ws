<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="tracked_v3">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <!-- 차체 중심: 지면에서 0.35m 높이에 배치 (바퀴 반지름 0.1m + 0.25m 여유) -->
      <pose>0 0 0.35 0 0 0</pose>

      <inertial>
          <mass>100.0</mass>
          <!-- 차체 1.1m x 1.3m x 0.5m 기준 관성 모멘트: I = (1/12) * m * (w^2 + h^2) -->
          <inertia>
          <ixx>16.25</ixx> <iyy>12.25</iyy> <izz>28.33</izz>
          <ixy>0.0</ixy> <ixz>0.0</ixz> <iyz>0.0</iyz>
          </inertia>
      </inertial>

      <collision name="chassis_collision">
          <geometry>
          <!-- 차체: 길이 1.1m, 폭 1.3m, 높이 0.5m -->
          <box><size>1.1 1.3 0.5</size></box>
          </geometry>
      </collision>

      <visual name="chassis_visual">
          <geometry>
          <box><size>1.1 1.3 0.5</size></box>
          </geometry>
          <material>
          <ambient>0.3 0.4 0.9 1</ambient>
          <diffuse>0.3 0.4 0.9 1</diffuse>
          </material>
      </visual>

      <sensor name="imu_sensor" type="imu">
          <always_on>true</always_on>
          <update_rate>25</update_rate>
          <visualize>false</visualize>
          <topic>imu</topic>
          <pose>0 0 0.25 0 0 0</pose>
          <imu>
            <orientation_reference_frame>
              <localization>ENU</localization>
            </orientation_reference_frame>
            <angular_velocity>
              <x>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </z>
            </angular_velocity>
            <linear_acceleration>
              <x>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.1</stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.1</stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.1</stddev>
                </noise>
              </z>
            </linear_acceleration>
          </imu>
      </sensor>

      <!-- <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
